  <div class="auth-card">
    <span class="page-icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" 
           viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" 
              d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
      </svg>
    </span>

    <h1>Sign In</h1>
    <form action="/login" method="post">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Enter your password" required>
      </div>
      <button type="submit" class="auth-btn">Continue</button>
    </form>
    <span class="auth-label">Don't have an account? <a href="/register">Create</a></span>
  </div>
  <script src="../js/forms.js"></script>
<% if (typeof error !== 'undefined' && error) { %>
    <div class="auth-alert">
      <div class="auth-alert-content">
        <button class="close-btn" onclick="closepopup()"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
</svg>
</button>
        <p class="error-text"><%= error %></p>
      </div>
    </div>
  <% } %>

<script>
  function closepopup () {
    const btn = document.querySelector('.auth-alert');
    btn.style.display = 'none';
  }
</script>