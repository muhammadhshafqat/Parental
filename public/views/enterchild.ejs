<div class="auth-card">
  <a class="back-nav-btn" href="/dashboard">&#8592; Back </a>
  <span class="page-icon">
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 0 1-6.364 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
</svg>
  </span>

  <h1>Add Child</h1>
  <form action="/dashboard/children/add" method="POST" class="child-form" id="childForm">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required placeholder="Enter full name">
      <small class="error-message"></small>
    </div>

    <div class="form-group">
      <label for="dob">Date of Birth</label>
      <input type="date" id="dob" name="dob" required placeholder="YYYY-MM-DD" max="">
      <small class="error-message"></small>
    </div>

    <div class="form-group">
      <label for="interests">Interests (use commas to separate)</label>
      <input type="text" id="interests" name="interests" required placeholder="e.g. Drawing, Chess, Football">
      <small class="error-message"></small>
    </div>

    <button type="submit" class="action-btn">Create Child</button>
  </form>
</div>
<script>
  // set max date to today to prevent future DOBs
  document.addEventListener('DOMContentLoaded', () => {
    const dobInput = document.getElementById('dob');
    if (dobInput) {
      const today = new Date().toISOString().split('T')[0];
      dobInput.setAttribute('max', today);
    }
  });
</script>
<script src="../js/forms.js"></script>
