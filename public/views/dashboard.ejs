<div id="dashMainContainer">
    <div id="children-selector">
        <button class="name-btn">Julianna Vance</button>
        <button class="name-btn">Marcus Thorne</button>
        <button class="name-btn">Elena Rossi</button>
    </div>


    <div id="dataDiv">

        <!-- Name and age header -->
        <div id="data-header">
            <h2>Juliana Vance</h2>
            <span class="age-tag"> 12 years old</span>
        </div>
        <!-- --- -->

        <!-- data body -->
        <div id="data-body">

            <!-- Interest -->
            <div class="data-section">
                <h3>Interests</h3>
                <p id="childInterests">Robotics, Digital Illustration, and competitive Swimming.</p>
            </div>
            <!-- --- -->

            <!-- Events -->
            <div class="data-section">
                <h3>Upcoming Events</h3>
                <ul class="event-list">
                    <li>
                        <span class="event-date">Jan 28</span>
                        <span class="event-name">Regional Swim Meet</span>
                    </li>
                    <li>
                        <span class="event-date">Feb 02</span>
                        <span class="event-name">Science Fair Setup</span>
                    </li>
                </ul>
            </div>

            <!-- --- -->

        </div>
        <!-- --- -->

        <!-- data footer -->
        <div id="data-footer">

            <button class="calendar-btn">
                <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Google_Calendar_icon_%282020%29.svg"
                    alt="Google Calendar" width="18">
                Sync with Google Calendar
            </button>

        </div>

    </div>


    <div id="aiDiv">

        <div class="chat-container">

            <% if (chatHistory) { %>
            
                <% chatHistory.forEach(function(msg) { %>
                
                    <div class="message <%= msg.role === 'user' ? 'user-message' : 'model-message' %>">
                        <div class="message-content">
                            <%= msg.message %>
                        
                        </div>
                    </div>
                <% }); %>

                </div>

            <% } %>
        
        <form id="chat-form">

            <input type="text" name="prompt" id="name-input"/>
            <button type="submit">-></button>
        </form>

    </div>
</div>