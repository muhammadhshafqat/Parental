<script>
    window.childrenData = <%- JSON.stringify(children || []).replace(/</g, '\\u003c') %>;
</script>
<h1 class="into-heading">
    <%= user.name %>'s Parenting Assistant
</h1>

<div id="dashMainContainer">
    <!-- Children Selector -->
    <div id="children-selector">

        <button class="plus-btn" id="addChildBtn" title="Add child" onclick="window.location.href='/dashboard/children'"
            type="button">+</button>
        <% if (children && children.length> 0) { %>
            <% children.forEach(function(child, idx) { %>
                <button class="name-btn <%= idx === 0 ? 'active' : '' %>" 
                        data-child-id="<%= child.id %>" 
                        type="button" 
                        data-chat-id="<%=child.chatId %>">
                    <%= child.name %>
                </button>
            <% }) %>
        <% } %>
    </div>

    <!-- Data Section -->
    <div id="dataDiv">
        <% if (firstChild) { %>
            <div id="data-header">
                <h2 class="childName" id="childName">
                    <%= firstChild.name %>
                </h2>
                <span class="age-tag <%= 
          firstChild.age < 13 ? 'age-child' : 
          firstChild.age <= 20 ? 'age-teen' : 
          '' 
        %>" id="childAge">
                    <%= firstChild.age %> y/o
                </span>
                <!-- Academics button for this child -->
                <button class="academics-btn" 
                        onclick="window.location.href='/dashboard/academics/<%= firstChild.id %>'" 
                        type="button">
                    Academics
                </button>
            </div>

            <div id="data-body">
                <div class="data-section">
                    <h3>Interests</h3>
                    <% if (Array.isArray(firstChild.interests) && firstChild.interests.length) { %>
                        <div id="childInterests">
                            <% firstChild.interests.forEach(function(interest) { %>
                                <span class="interest-tag"><%= interest %></span>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p id="childInterests">No interests listed.</p>
                    <% } %>
                </div>

                <div class="data-section">
                    <h3>Upcoming Events</h3>
                    <ul class="event-list" id="eventList">
                        <% if (firstChild.events && firstChild.events.length> 0) { %>
                            <% firstChild.events.forEach(function(ev) { %>
                                <li>
                                    <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=<%= encodeURIComponent(ev.name) %>&location=<%= encodeURIComponent(ev.location) %>&dates=<%= new Date(ev.time).toISOString().replace(/[-:]/g,'').split('.')[0] %>/<%= new Date(ev.time).toISOString().replace(/[-:]/g,'').split('.')[0] %>"
                                        target="_blank" rel="noopener noreferrer">
                                        <button class="calendar-btn">
                                            <img src="https://upload.wikimedia.org/wikipedia/commons/a/a5/Google_Calendar_icon_%282020%29.svg"
                                                alt="Google Calendar" width="18">
                                        </button>
                                    </a>
                                    <span class="event-date"><%= new Date(ev.time).toLocaleDateString() %></span>
                                    <span class="event-name"><%= ev.name %></span>
                                    <span class="event-place"><%= ev.location %></span>
                                </li>
                            <% }) %>
                        <% } else { %>
                            <li>No events yet</li>
                        <% } %>
                    </ul>
                </div>
            </div>
        <% } else { %>
            <div id="data-header">
                <h2 class="childName" id="childName">No child selected</h2>
                <span class="age-tag" id="childAge"></span>
            </div>
            <div id="data-body">
                <p>Add a child profile to see interests and events.</p>
            </div>
        <% } %>
    </div>

	<div id="aiDiv">
		<div class="invisible-spacing"></div>
		<div class="chat-container">
		
		</div>

		<form id="chat-form">
				<input type="text" name="prompt" id="name-input" />
				<button type="submit"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
				</svg></button>
				<button type="submit"  class="event-btn-submit" name="event-btn-submit" id="event-btn-submit"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
				<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 1 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 1 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
				</svg>
				</button>

		</form>
	</div>
</div>

<!-- Client script for interactivity -->
<script src="/js/dash.js"></script>
